# PLACEHOLDERS ONLY. This file contains no secret values.
SECRETS_PATH=/run/secrets/chrona
DB_URL=jdbc:postgresql://chrona-db:5432/chrona?connectTimeout=5&socketTimeout=10&tcpKeepAlive=true
DB_USER=chrona
# Safe API boot before the owner creates the bot; BOT_USERNAME is not required.
TELEGRAM_AUTH_ENABLED=false
# To enable new Telegram login challenges, set true AND the real bot username.
# BOT_USERNAME=replace_with_owner_created_bot
# Bot mode ALWAYS requires BOT_USERNAME and the telegram-token secret file,
# even if new login challenges are explicitly disabled.
# Required for bot; SOCKS5 remote DNS ONLY, independent infra service.
TELEGRAM_PROXY=socks5h://xray-proxy:10808
# Local default. Container private network binding requires explicit sysadmin
# override to 0.0.0.0 and no public publish; host publish only 127.0.0.1:8080.
BIND_ADDRESS=127.0.0.1
# API=8080; BOT management default=8081. Do not reuse PORT across both modes.
PORT=8080
JAVA_OPTS=-Xms32m -Xmx256m -Dorg.slf4j.simpleLogger.defaultLogLevel=warn
