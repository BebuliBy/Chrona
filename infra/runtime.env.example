# Nonsecret metadata only. Copy OUTSIDE repository after layout approval.
# Digest values are deliberately NOT invented. All three references REQUIRED.
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.3.27@sha256:4198aa816f04eeacde6470f4f07947eb4f701a1bba3657e366636681eaae5855
POSTGRES_IMAGE=postgres:17-alpine@sha256:aa90e97ee862e558111d34cfb8b2c4bec768c2b039fb791341686928560263b3
BACKEND_IMAGE=chrona-backend:REQUIRED_VERSION@sha256:REQUIRED_VERIFIED_MANIFEST_DIGEST
# Updated developer distribution contract reviewed: api/bot/migrate/healthcheck,
# TELEGRAM_AUTH_ENABLED=false supports API before BotFather.
BACKEND_CONTRACT=approved-v1
# Must be recorded only after baseline-amd64 runtime checks on target CPU.
CPU_SMOKE=NOT_READY
# API/SQL works without bot. Later owner-created BOT_USERNAME goes in
# private /etc/chrona/telegram.env, never in Git. Bot profile remains off.
TELEGRAM_AUTH_ENABLED=false
# Candidate loopback port: must check live server baseline first.
API_HOST_PORT=18080
